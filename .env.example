# Free key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=

# Optional: Telegram alerts after each daily refresh (see README -> Telegram alerts)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# FINN_OWNER_PIN=        # lets you sync your portfolio + rules from the app
# FINN_PUBLIC_URL=       # e.g. https://<your-space>.hf.space, used for links in messages

# Optional: contact URL (e.g. your GitHub repo) sent in the User-Agent for Wikipedia
# profile lookups of newly appointed executives. Lookups are skipped if unset (Wikimedia policy).
# FINN_CONTACT=https://github.com/<you>/finn

# Optional: pin models instead of auto-picking the newest stable flash / flash-lite
# FINN_CHEAP_MODEL=gemini-2.5-flash-lite
# FINN_STRONG_MODEL=gemini-2.5-flash

# Recommended: free Groq key (https://console.groq.com/keys). Used as the backup reasoner for the
# Promise Ledger when Gemini Flash's small free daily quota runs out. The model is auto-picked
# (gpt-oss-120b, then llama-3.3-70b...) unless OPENAI_COMPAT_MODEL is set.
GROQ_API_KEY=
# Or any other OpenAI-compatible endpoint (OpenRouter, local Ollama):
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
